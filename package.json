{
  "name": "login-page",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 ESBUILD_BINARY_PATH=node_modules/esbuild/bin/esbuild ng serve",
    "dev:win": "set NODE_OPTIONS=--max-old-space-size=4096 && set ESBUILD_BINARY_PATH=node_modules/esbuild/bin/esbuild && ng serve",
