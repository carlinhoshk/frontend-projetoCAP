    "@angular/platform-browser": "^16.2.10",
    "@angular/platform-browser-dynamic": "^16.2.10",
    "@angular/router": "^16.2.10",
    "glob": "^11.0.2",
    "ngx-toastr": "^19.0.0",
    "playwright-ng-schematics": "^2.0.3",
    "rimraf": "^6.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
